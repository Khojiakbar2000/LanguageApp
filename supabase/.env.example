# Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# in deployed Edge Functions. Local `supabase functions serve` supplies them too.
GEMINI_API_KEY=your-server-only-gemini-api-key
# Set a currently available model with generateContent + JSON-schema output support.
GEMINI_MODEL=your-available-gemini-model-id
ELEVENLABS_API_KEY=your-server-only-elevenlabs-key
ELEVENLABS_VOICE_ID=your-licensed-korean-capable-voice-id
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Vocabulary import only; never expose this key to Expo/mobile builds.
# Register at https://krdict.korean.go.kr/eng/openApi/openApiRegister
KRDICT_API_KEY=PASTE_YOUR_KRDICT_API_KEY_HERE
# Importer additionally requires SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and an explicit query.
# Optional examples: KRDICT_QUERY=사랑 KRDICT_LEVEL=level1 KRDICT_MAX_REQUESTS=500
