{
  "name": "haru-korean",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "node scripts/test-database.mjs",
    "vocabulary:import": "tsx scripts/import-krdict.ts",
    "vocabulary:import:initial": "node scripts/import-krdict-initial.mjs",
    "vocabulary:import:level": "node scripts/import-krdict-level.mjs",
    "test:browser": "playwright test",
    "test:journey": "playwright test --config playwright.integration.config.ts",
    "format": "prettier --write app src scripts tests supabase/functions *.json *.js *.mts playwright*.ts README.md",
    "check:functions": "deno check --config supabase/functions/deno.json supabase/functions/conversation/index.ts supabase/functions/transcribe/index.ts supabase/functions/speak/index.ts supabase/functions/speak-lesson/index.ts supabase/functions/pronounce-vocabulary/index.ts supabase/functions/delete-account/index.ts",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "mascot:sync": "node scripts/rive/sync-runtime.mjs",
    "mascot:build": "node scripts/rive/import-panda.mjs && node scripts/rive/build-panda.mjs && node scripts/rive/export-panda.mjs && npm run mascot:sync",
    "room:build": "node scripts/rive/export-cozy-room.mjs",
    "test:widgets:prebuild": "node scripts/verify-widgets-prebuild.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@expo/ui": "~58.0.26",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rive-app/react-canvas": "^4.38.0",
    "@supabase/supabase-js": "^2.118.0",
    "@xmldom/xmldom": "^0.8.15",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-widgets": "~58.0.26",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "rive-react-native": "^9.8.6",
    "tailwindcss": "^3.4.17",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "deno": "^2.9.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "prettier": "^3.9.10",
    "rive-mcp-server": "^0.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules",
      "android": {
        "exclude": [
          "expo-widgets",
          "@expo/ui"
        ]
      }
    }
  }
}
