# These two values are PUBLIC client configuration, never provider secrets.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-legacy-anon-key

# KRDICT credential is server/import-only. Never prefix this with EXPO_PUBLIC_.
KRDICT_API_KEY=PASTE_YOUR_KRDICT_API_KEY_HERE
